---
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Uhrgeschichten</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;700&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --font-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-serif: 'DM Serif Display', Georgia, serif;
        --color-bg: #ffffff;
        --color-surface: #ffffff;
        --color-soft: #f7f7f7;
        --color-text: #1c1c1c;
        --color-subtle: #5f5f5f;
        --color-accent: #111111;
        --color-muted: #666666;
        --color-border: #dcdcdc;
        --spacing-xl: 6rem;
        --spacing-2xl: 9rem;
        --container: 1180px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--font-sans);
        color: var(--color-text);
        background: var(--color-bg);
        line-height: 1.7;
      }
      img { display: block; max-width: 100%; }
      p { margin: 0; }
      h1, h2, h3, h4 { margin: 0; font-family: var(--font-serif); font-weight: 400; }
      h1 { font-size: clamp(2.4rem, 6vw, 5rem); line-height: 1.02; }
      h2 { font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.12; }
      .container { width: min(var(--container), calc(100% - 2rem)); margin: 0 auto; }
      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255,255,255,0.92);
        border-bottom: 1px solid var(--color-border);
        backdrop-filter: blur(14px);
      }
      nav { min-height: 72px; display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; }
      .logo {
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
      }
      .logo span { color: var(--color-muted); }
      .nav-links { display: flex; gap: 1.25rem; align-items: center; }
      .nav-links a {
        color: var(--color-muted);
        text-decoration: none;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .nav-links a:hover { color: var(--color-text); }
      .eyebrow {
        color: #777777;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        border: 1px solid var(--color-text);
        padding: 0.8rem 1.35rem;
        color: var(--color-text);
        text-decoration: none;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .btn:hover, .btn-primary { background: var(--color-text); color: white; }
      .btn-primary:hover { background: var(--color-accent); border-color: var(--color-accent); }
      .page-hero { padding: 7rem 0 4rem; text-align: center; background: linear-gradient(180deg, var(--color-soft), var(--color-bg)); }
      .page-hero p { max-width: 680px; margin: 1.25rem auto 0; color: var(--color-muted); }
      .story-article {
        width: min(920px, calc(100% - 2rem));
        max-width: none;
        margin: 0 auto;
        padding: 5rem 0 7rem;
      }
      .story-header {
        max-width: 780px;
        margin: 0 auto 3rem;
        text-align: center;
      }
      .story-category {
        margin-bottom: 1rem;
        color: #777;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }
      .story-header h1 {
        margin-bottom: 1.25rem;
        font-size: clamp(2.35rem, 6vw, 4.8rem);
        line-height: 1.04;
      }
      .story-meta-line {
        display: flex;
        justify-content: center;
        gap: 0.6rem;
        color: var(--color-muted);
        font-size: 0.78rem;
      }
      .story-hero-img {
        display: grid;
        min-height: 560px;
        margin: 0 0 4rem;
        padding: 3rem;
        place-items: center;
        background: #fff;
        border: 1px solid var(--color-border);
      }
      .story-hero-img img {
        width: min(100%, 440px);
        max-width: 440px;
        max-height: 500px;
        object-fit: contain;
        mix-blend-mode: multiply;
      }
      .story-body {
        width: min(680px, 100%);
        margin: 0 auto;
        color: var(--color-text);
        font-size: 1.02rem;
        line-height: 1.9;
      }
      .story-body > p { margin-bottom: 1.5rem; }
      .story-lede {
        margin-bottom: 2.5rem;
        padding: 0 0 0 1.25rem;
        border-left: 2px solid var(--color-text);
        color: var(--color-subtle);
        font-family: var(--font-serif);
        font-size: 1.22rem;
        font-style: normal;
        line-height: 1.75;
      }
      .story-body h2 {
        margin: 3.5rem 0 1rem;
        font-size: clamp(1.65rem, 4vw, 2.35rem);
      }
      .story-quote {
        margin: 3rem 0;
        padding: 2rem;
        background: #fff;
        border: 1px solid var(--color-border);
        border-left: 4px solid var(--color-text);
        border-radius: 0;
        font-family: var(--font-serif);
        font-size: 1.15rem;
        font-style: normal;
        line-height: 1.7;
      }
      .story-specs {
        margin: 3rem 0;
        padding: 2rem;
        background: #fff;
        border: 1px solid var(--color-border);
        border-radius: 0;
      }
      .story-specs h3 { margin-bottom: 1rem; font-size: 1.2rem; }
      .story-specs ul { margin: 0; padding: 0; list-style: none; }
      .story-specs li { padding: 0.55rem 0; border-bottom: 1px solid var(--color-border); }
      .story-specs li:last-child { border-bottom: 0; }
      .story-cta {
        margin-top: 4rem;
        padding: 2.25rem;
        background: #fff;
        border: 1px solid var(--color-border);
        border-radius: 0;
        text-align: center;
      }
      .story-cta p { margin-bottom: 1.25rem; color: var(--color-muted); }
      footer { padding: 3rem 0; border-top: 1px solid var(--color-border); color: var(--color-muted); background: var(--color-surface); font-size: 0.85rem; }
      .footer-inner { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; }
      footer .brand { font-family: var(--font-serif); font-size: 1.2rem; color: var(--color-text); margin-bottom: 0.35rem; }
      @media (max-width: 700px) {
        nav { min-height: 64px; flex-direction: column; align-items: flex-start; justify-content: center; gap: 0.5rem; padding: 0.75rem 0; }
        .nav-links { width: 100%; justify-content: space-between; gap: 0.75rem; }
        .footer-inner { flex-direction: column; }
        .story-article { padding: 3rem 0 5rem; }
        .story-header h1 { font-size: 2.35rem; }
        .story-hero-img { min-height: 390px; padding: 1.5rem; }
        .story-hero-img img { max-height: 340px; }
        .story-quote, .story-specs, .story-cta { padding: 1.35rem; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <nav aria-label="Hauptnavigation">
          <a href="/" class="logo">Uhr<span>geschichten</span></a>
          <div class="nav-links">
            <a href="/geschichten.html">Stories</a>
            <a href="/uhren">Kaufberatung</a>
            <a href="/ueber-uns">Über uns</a>
          </div>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="container footer-inner">
        <div>
          <div class="brand">Uhrgeschichten</div>
          <p>Geschichten über Gestaltung, Herkunft und die Menschen hinter besonderen Uhren.</p>
        </div>
        <p>Affiliate-Hinweis: Wir koennen Provision erhalten, wenn Leser ueber CreationWatches-Links kaufen. &copy; 2026 Uhrgeschichten.</p>
      </div>
    </footer>
  </body>
</html>

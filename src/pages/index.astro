---
import BaseLayout from '../layouts/BaseLayout.astro';
import products from '../data/products.json';

const storyWatch = products.find((p) => p.sku === 'H64635140') || products[0];
const featured = products.slice(0, 4);
const brands = [...new Set(products.map((p) => p.brand).filter(Boolean))].slice(0, 8);
const focusSpecs = [
  ['Typ', 'Automatik'],
  ['Stil', 'Fliegeruhr'],
  ['Wasser', '100M'],
];
const filters = ['Alle', 'Automatik', '200M', 'Unter 250 EUR', 'Seiko', 'Casio'];
const productLabels = ['Diver', 'Digital', 'Field', 'Japan'];
const productNotes = [
  'Robuste Taucheruhr mit klarer Sportfunktion.',
  'Alltagsuhr mit reduzierter, digitaler Funktionalitaet.',
  'Leicht, automatisch und gut lesbar.',
  'Made in Japan, 200M und klassische Pepsi-Luenette.',
];
---

<BaseLayout title="Uhrgeschichten" description="Minimalistische Uhrengeschichten und Kaufberatung fuer deutsche Leser.">
  <section class="shop-hero">
    <div class="container">
      <div class="kicker">
        <span>{products.length} kuratierte Guides</span>
        <span>Preispruefung bei CreationWatches</span>
        <span>Fuer deutsche Suchintentionen</span>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Minimalistische Kaufberatung</p>
          <h1>Uhren klar vergleichen.</h1>
          <p>Weniger Erzaehlung, mehr Orientierung: Modell, Stil, Preisgefuehl und naechster Schritt sind sofort sichtbar.</p>
        </div>
        {storyWatch && (
          <a href={storyWatch.url || '/uhren'} class="feature-watch" target="_blank" rel="noopener noreferrer">
            <div class="watch-media">
              <img src={storyWatch.image} alt={storyWatch.name} />
            </div>
            <div class="watch-copy">
              <span>Im Fokus</span>
              <h2>{storyWatch.name}</h2>
              <dl>
                {focusSpecs.map(([term, detail]) => (
                  <div><dt>{term}</dt><dd>{detail}</dd></div>
                ))}
              </dl>
              <strong>Aktuellen Preis pruefen</strong>
            </div>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="toolbar" id="beratung">
    <div class="container">
      <div class="toolbar-row">
        <div>
          <p class="eyebrow">Katalog</p>
          <h2>Ausgewaehlte Uhren</h2>
        </div>
        <div class="sort">
          <span>Sortieren</span>
          <button>Empfohlen</button>
          <button>Preis</button>
          <button>Marke</button>
        </div>
      </div>
      <div class="filters" aria-label="Filter">
        {filters.map((filter) => <button>{filter}</button>)}
      </div>
    </div>
  </section>

  <section class="catalog">
    <div class="container">
      <div class="catalog-grid">
        {featured.map((product, index) => (
          <a href={product.url || '/uhren'} class="catalog-card" target="_blank" rel="noopener noreferrer">
            <span class="badge">{productLabels[index] || product.brand}</span>
            <img src={product.image} alt={product.name} loading="lazy" />
            <div>
              <small>{product.brand}</small>
              <h3>{product.name}</h3>
              <p>{productNotes[index] || 'Klare Daten, Preislink und Kaufkontext auf einen Blick.'}</p>
              <strong>Preis pruefen</strong>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="buying-notes" id="stories">
    <div class="container">
      <div><span>01</span><h3>Technische Daten zuerst</h3><p>Deutsche Leser vergleichen schnell. Uhrwerk, Wasserresistenz und Preislink bleiben nah am Produkt.</p></div>
      <div><span>02</span><h3>Weissraum als Produktbuehne</h3><p>Die Uhr steht auf ruhiger Flaeche; Border und Typografie uebernehmen die Struktur statt schwerer Farbflaechen.</p></div>
      <div><span>03</span><h3>Direkter naechster Schritt</h3><p>Der CTA ist nuechtern formuliert und fuehrt direkt zur aktuellen Preis- und Verfuegbarkeitspruefung.</p></div>
    </div>
  </section>

  <section class="brands" id="marken">
    <div class="container">
      <p class="eyebrow">Marken im Funnel</p>
      <div class="brand-list">{brands.map((brand) => <span>{brand}</span>)}</div>
    </div>
  </section>
</BaseLayout>

<style>
  .shop-hero { background: #fff; border-bottom: 1px solid var(--color-border); padding: 1.75rem 0 0; }
  .kicker { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--color-border); border-bottom: 0; color: #646464; font-size: 0.82rem; font-weight: 700; text-transform: uppercase; }
  .kicker span { padding: 0.8rem 1rem; border-right: 1px solid var(--color-border); }
  .kicker span:last-child { border-right: 0; }
  .hero-grid { display: grid; grid-template-columns: 0.82fr 1.18fr; min-height: 560px; border: 1px solid var(--color-border); }
  .hero-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(1.75rem, 6vw, 4.5rem); border-right: 1px solid var(--color-border); }
  .hero-copy h1 { max-width: 520px; font-family: var(--font-sans); font-size: clamp(3rem, 7vw, 7rem); font-weight: 700; line-height: 0.92; letter-spacing: 0; }
  .hero-copy p:not(.eyebrow) { max-width: 430px; margin-top: 1.5rem; color: #555; font-size: 1.02rem; }
  .feature-watch { display: grid; grid-template-columns: 1fr 320px; color: inherit; text-decoration: none; }
  .watch-media { display: grid; place-items: center; min-height: 420px; border-right: 1px solid var(--color-border); }
  .watch-media img { width: min(76%, 460px); aspect-ratio: 1; object-fit: contain; }
  .watch-copy { display: flex; flex-direction: column; justify-content: end; padding: 1.75rem; }
  .watch-copy span, .catalog-card small { color: #777; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .watch-copy h2 { margin: 0.85rem 0 1.35rem; font-family: var(--font-sans); font-size: 1.25rem; font-weight: 700; line-height: 1.2; }
  .watch-copy dl { margin: 0 0 1.6rem; border-top: 1px solid var(--color-border); }
  .watch-copy dl div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--color-border); }
  .watch-copy dt { color: #777; }
  .watch-copy dd { margin: 0; font-weight: 800; }
  .watch-copy strong, .catalog-card strong { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; border: 1px solid #111; padding: 0 0.9rem; font-size: 0.86rem; font-weight: 800; text-transform: uppercase; }
  .toolbar { background: #fff; border-bottom: 1px solid var(--color-border); padding: 1.9rem 0 1.25rem; }
  .toolbar-row { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; }
  .toolbar h2 { font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 4rem); font-weight: 700; line-height: 1; }
  .sort { display: flex; align-items: center; gap: 0.5rem; color: #777; font-size: 0.78rem; font-weight: 800; text-transform: uppercase; }
  .sort button, .filters button { min-height: 36px; border: 1px solid var(--color-border); background: #fff; padding: 0 0.8rem; color: #111; font: inherit; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
  .catalog { background: #fff; padding: 0 0 2.9rem; }
  .catalog-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-left: 1px solid var(--color-border); }
  .catalog-card { position: relative; display: grid; grid-template-rows: 290px 1fr; min-height: 520px; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); color: inherit; text-decoration: none; }
  .badge { position: absolute; top: 0.9rem; left: 0.9rem; border: 1px solid var(--color-border); background: #fff; padding: 0.3rem 0.55rem; font-size: 0.72rem; font-weight: 900; text-transform: uppercase; }
  .catalog-card img { width: 100%; height: 100%; object-fit: contain; padding: 2.1rem; border-bottom: 1px solid var(--color-border); }
  .catalog-card div { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.1rem; }
  .catalog-card h3 { min-height: 52px; font-family: var(--font-sans); font-size: 1rem; font-weight: 700; line-height: 1.25; }
  .catalog-card p { color: #666; font-size: 0.9rem; }
  .catalog-card strong { margin-top: auto; }
  .buying-notes { background: #fafafa; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .buying-notes .container { display: grid; grid-template-columns: repeat(3, 1fr); border-left: 1px solid var(--color-border); }
  .buying-notes .container > div { min-height: 230px; padding: 1.75rem; border-right: 1px solid var(--color-border); }
  .buying-notes span { color: #777; font-weight: 900; }
  .buying-notes h3 { margin: 1.1rem 0 0.6rem; font-family: var(--font-sans); font-weight: 700; }
  .buying-notes p { color: #666; }
  .brands { padding: 2.25rem 0; background: #fff; }
  .brand-list { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .brand-list span { border: 1px solid var(--color-border); padding: 0.55rem 0.85rem; background: #fff; color: var(--color-subtle); font-size: 0.85rem; }
  @media (max-width: 980px) {
    .kicker, .hero-grid, .feature-watch, .catalog-grid, .buying-notes .container { grid-template-columns: 1fr; }
    .kicker span, .hero-copy, .watch-media { border-right: 0; border-bottom: 1px solid var(--color-border); }
    .toolbar-row { align-items: start; flex-direction: column; }
    .sort { flex-wrap: wrap; }
    .catalog-card { min-height: auto; }
  }
</style>

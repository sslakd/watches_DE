---
import BaseLayout from '../layouts/BaseLayout.astro';
import products from '../data/products.json';

const storyWatch = products.find((p) => p.sku === 'H64635140') || products[0];
const brands = [...new Set(products.map((p) => p.brand).filter(Boolean))].slice(0, 8);
const focusSpecs = [
  ['Typ', 'Automatik'],
  ['Stil', 'Fliegeruhr'],
  ['Wasser', '100M'],
];
const storyCards = [
  {
    label: 'Fliegeruhr',
    brand: 'Hamilton',
    title: 'Khaki Aviation Pilot',
    href: '/geschichten/hamilton-khaki-aviation.html',
    image: 'https://cdnstatic.creationwatches.com/products/product-images/l/H64635140.webp',
    note: 'Vom Cockpit-Erbe zur modernen Alltagsuhr.',
  },
  {
    label: 'Taucheruhr',
    brand: 'Hamilton',
    title: 'Khaki Scuba',
    href: '/geschichten/khaki-scuba-h82315931.html',
    image: 'https://cdnstatic.creationwatches.com/products/product-images/l/H82315931_LRG.webp',
    note: 'Eine Sportuhr ueber Wasser, Druck und Vertrauen.',
  },
  {
    label: 'Open Heart',
    brand: 'Hamilton',
    title: 'Jazzmaster Open Heart',
    href: '/geschichten/jazzmaster-open-heart.html',
    image: 'https://cdnstatic.creationwatches.com/products/product-images/l/H32215141_LRG.webp',
    note: 'Der Blick ins Werk als Teil der Geschichte.',
  },
  {
    label: 'Ikone',
    brand: 'Tissot',
    title: 'PRX T137.410',
    href: '/geschichten/tissot-prx-t137-410.html',
    image: 'https://cdnstatic.creationwatches.com/products/product-images/l/T137.410.11.051.00_LRG.webp',
    note: 'Retro-Linien, Schweizer Praezision und klare Form.',
  },
];
---

<BaseLayout title="Uhrgeschichten" description="Minimalistische Uhrengeschichten und Kaufberatung fuer deutsche Leser.">
  <section class="shop-hero">
    <div class="container">
      <div class="kicker">
        <span>1. Uhr entdecken</span>
        <span>2. Geschichte lesen</span>
        <span>3. Preis bei CreationWatches pruefen</span>
      </div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Uhren, Herkunft und Handwerk</p>
          <h1>Erst die Uhr sehen. Dann ihre Geschichte verstehen.</h1>
          <p>Jede Uhr bekommt zuerst Kontext: ihre Herkunft, ihre Gestaltung und das Gefühl, das sie am Handgelenk vermittelt.</p>
        </div>
        {storyWatch && (
          <a href="/geschichten/hamilton-khaki-aviation.html" class="feature-watch">
            <div class="watch-media">
              <img src={storyWatch.image} alt={storyWatch.name} />
            </div>
            <div class="watch-copy">
              <span>Story im Fokus</span>
              <h2>Hamilton Khaki Aviation Pilot</h2>
              <dl>
                {focusSpecs.map(([term, detail]) => (
                  <div><dt>{term}</dt><dd>{detail}</dd></div>
                ))}
              </dl>
              <strong>Geschichte lesen</strong>
            </div>
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="toolbar" id="beratung">
    <div class="container">
      <div class="toolbar-row">
        <div>
          <p class="eyebrow">Story-Auswahl</p>
          <h2>Schoene Uhren mit einem Grund, naeher hinzusehen</h2>
        </div>
        <div class="flow-line" aria-label="Userflow">
          <span>Sehen</span>
          <span>Lesen</span>
          <span>Kaufen</span>
        </div>
      </div>
    </div>
  </section>

  <section class="story-selection">
    <div class="container">
      <div class="story-grid">
        {storyCards.map((story) => (
          <a href={story.href} class="story-card">
            <span class="badge">{story.label}</span>
            <img src={story.image} alt={`${story.brand} ${story.title}`} loading="lazy" />
            <div>
              <small>{story.brand}</small>
              <h3>{story.title}</h3>
              <p>{story.note}</p>
              <strong>Story lesen</strong>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="buying-notes" id="stories">
    <div class="container">
      <div><span>01</span><h3>Form und erster Eindruck</h3><p>Proportionen, Zifferblatt und Material entscheiden oft in wenigen Sekunden, ob eine Uhr neugierig macht.</p></div>
      <div><span>02</span><h3>Herkunft und Charakter</h3><p>Design, Werk und Geschichte zeigen, ob der erste Eindruck auch bei näherem Hinsehen trägt.</p></div>
      <div><span>03</span><h3>Preis und Verfügbarkeit</h3><p>Am Ende jeder Geschichte lässt sich das aktuelle Angebot bei CreationWatches transparent prüfen.</p></div>
    </div>
  </section>

  <section class="brands" id="marken">
    <div class="container">
      <p class="eyebrow">Marken im Archiv</p>
      <div class="brand-list">{brands.map((brand) => <span>{brand}</span>)}</div>
    </div>
  </section>
</BaseLayout>

<style>
  .shop-hero { background: #fff; border-bottom: 1px solid var(--color-border); padding: 1.75rem 0 0; }
  .kicker { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--color-border); border-bottom: 0; color: #646464; font-size: 0.82rem; font-weight: 700; text-transform: uppercase; }
  .kicker span { padding: 0.8rem 1rem; border-right: 1px solid var(--color-border); }
  .kicker span:last-child { border-right: 0; }
  .hero-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; min-height: 560px; border: 1px solid var(--color-border); }
  .hero-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(1.75rem, 6vw, 4.5rem); border-right: 1px solid var(--color-border); }
  .hero-copy h1 { max-width: 620px; font-family: var(--font-sans); font-size: clamp(2.7rem, 6vw, 5.9rem); font-weight: 700; line-height: 0.95; letter-spacing: 0; }
  .hero-copy p:not(.eyebrow) { max-width: 430px; margin-top: 1.5rem; color: #555; font-size: 1.02rem; }
  .feature-watch { display: grid; grid-template-columns: 1fr 320px; color: inherit; text-decoration: none; }
  .watch-media { display: grid; place-items: center; min-height: 420px; border-right: 1px solid var(--color-border); }
  .watch-media img { width: min(76%, 460px); aspect-ratio: 1; object-fit: contain; }
  .watch-copy { display: flex; flex-direction: column; justify-content: end; padding: 1.75rem; }
  .watch-copy span, .catalog-card small { color: #777; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  .watch-copy h2 { margin: 0.85rem 0 1.35rem; font-family: var(--font-sans); font-size: 1.25rem; font-weight: 700; line-height: 1.2; }
  .watch-copy dl { margin: 0 0 1.6rem; border-top: 1px solid var(--color-border); }
  .watch-copy dl div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--color-border); }
  .watch-copy dt { color: #777; }
  .watch-copy dd { margin: 0; font-weight: 800; }
  .watch-copy strong, .catalog-card strong { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; border: 1px solid #111; padding: 0 0.9rem; font-size: 0.86rem; font-weight: 800; text-transform: uppercase; }
  .toolbar { background: #fff; border-bottom: 1px solid var(--color-border); padding: 1.9rem 0 1.25rem; }
  .toolbar-row { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; }
  .toolbar h2 { font-family: var(--font-sans); font-size: clamp(2rem, 4vw, 4rem); font-weight: 700; line-height: 1; }
  .flow-line { display: flex; align-items: center; gap: 0.5rem; color: #777; font-size: 0.78rem; font-weight: 800; text-transform: uppercase; }
  .flow-line span { min-height: 36px; border: 1px solid var(--color-border); background: #fff; padding: 0.45rem 0.8rem; color: #111; }
  .story-selection { background: #fff; padding: 0 0 2.9rem; }
  .story-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-left: 1px solid var(--color-border); }
  .story-card { position: relative; display: grid; grid-template-rows: 290px 1fr; min-height: 520px; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); color: inherit; text-decoration: none; }
  .badge { position: absolute; top: 0.9rem; left: 0.9rem; border: 1px solid var(--color-border); background: #fff; padding: 0.3rem 0.55rem; font-size: 0.72rem; font-weight: 900; text-transform: uppercase; }
  .story-card img { width: 100%; height: 100%; object-fit: contain; padding: 2.1rem; border-bottom: 1px solid var(--color-border); }
  .story-card div { display: flex; flex-direction: column; gap: 0.75rem; padding: 1.1rem; }
  .story-card h3 { min-height: 52px; font-family: var(--font-sans); font-size: 1.08rem; font-weight: 700; line-height: 1.25; }
  .story-card p { color: #666; font-size: 0.9rem; }
  .story-card strong { margin-top: auto; }
  .buying-notes { background: #fafafa; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .buying-notes .container { display: grid; grid-template-columns: repeat(3, 1fr); border-left: 1px solid var(--color-border); }
  .buying-notes .container > div { min-height: 230px; padding: 1.75rem; border-right: 1px solid var(--color-border); }
  .buying-notes span { color: #777; font-weight: 900; }
  .buying-notes h3 { margin: 1.1rem 0 0.6rem; font-family: var(--font-sans); font-weight: 700; }
  .buying-notes p { color: #666; }
  .brands { padding: 2.25rem 0; background: #fff; }
  .brand-list { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .brand-list span { border: 1px solid var(--color-border); padding: 0.55rem 0.85rem; background: #fff; color: var(--color-subtle); font-size: 0.85rem; }
  @media (max-width: 980px) {
    .kicker, .hero-grid, .feature-watch, .story-grid, .buying-notes .container { grid-template-columns: 1fr; }
    .kicker span, .hero-copy, .watch-media { border-right: 0; border-bottom: 1px solid var(--color-border); }
    .toolbar-row { align-items: start; flex-direction: column; }
    .flow-line { flex-wrap: wrap; }
    .story-card { min-height: auto; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import products from '../data/products.json';

const storyWatch = products.find((p) => p.sku === 'H64635140') || products[0];
const featured = products.slice(0, 8);
const brands = [...new Set(products.map((p) => p.brand).filter(Boolean))].slice(0, 8);
---

<BaseLayout title="Uhrgeschichten" description="Redaktionelle Uhrengeschichten, Kaufberatung und CreationWatches-Preislinks.">
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Editorial Affiliate Guides</p>
        <h1>Geschichten, die Leser zur passenden Uhr fuehren.</h1>
        <p>
          Uhrgeschichten erklaert Herkunft, Stil, Alltagstauglichkeit und Preisgefuehl
          einer Uhr. Wer kaufbereit ist, wird direkt zum aktuellen Angebot bei
          CreationWatches gefuehrt.
        </p>
        <div class="hero-actions">
          <a href="/uhren" class="btn btn-primary">Kaufberatung lesen</a>
          <a href="/geschichten/hamilton-khaki-aviation.html" class="btn">Story lesen</a>
        </div>
      </div>

      {storyWatch && (
        <a href={storyWatch.url || '/uhren'} class="hero-watch" target="_blank" rel="noopener noreferrer">
          <span>Story Spotlight</span>
          <img src={storyWatch.image} alt={storyWatch.name} />
          <strong>{storyWatch.name}</strong>
          <em>{storyWatch.price_usd > 0 ? `$${storyWatch.price_usd.toFixed(2)}` : 'Preis ansehen'}</em>
          <small>Aktuellen Preis bei CreationWatches pruefen</small>
        </a>
      )}
    </div>
  </section>

  <section class="beliefs">
    <div class="container beliefs-grid">
      <div>
        <p class="eyebrow">Funnel statt Shop</p>
        <h2>Erst Vertrauen, dann Klick.</h2>
      </div>
      <div class="belief-list">
        <article><span>01</span><h3>Suchintention</h3><p>Stories beantworten Fragen, bevor Leser Preise vergleichen.</p></article>
        <article><span>02</span><h3>Kaufkontext</h3><p>Jede Uhr wird nach Anlass, Stil, Marke und Budget eingeordnet.</p></article>
        <article><span>03</span><h3>Affiliate-Klick</h3><p>Der naechste Schritt ist klar: Preis und Verfuegbarkeit bei CreationWatches pruefen.</p></article>
      </div>
    </div>
  </section>

  <section class="featured">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Kaufberatung</p>
          <h2>Uhren mit Suchpotenzial</h2>
        </div>
        <a href="/uhren" class="text-link">Alle {products.length} Guides</a>
      </div>
      <div class="product-grid">
        {featured.map((product) => (
          <a href={product.url || '/uhren'} class="product-card" target="_blank" rel="noopener noreferrer">
            <div class="product-image"><img src={product.image} alt={product.name} loading="lazy" /></div>
            <div class="product-info">
              <span>{product.brand}</span>
              <h3>{product.name}</h3>
              <strong>{product.price_usd > 0 ? `$${product.price_usd.toFixed(2)}` : 'Details ansehen'}</strong>
              <small>Preis bei CreationWatches pruefen</small>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="brand-strip">
    <div class="container">
      <p class="eyebrow">Marken im Funnel</p>
      <div class="brand-list">{brands.map((brand) => <span>{brand}</span>)}</div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { padding: 6rem 0; background: linear-gradient(180deg, var(--color-soft), var(--color-bg)); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.75fr); gap: 4rem; align-items: center; }
  .hero-copy p:not(.eyebrow) { max-width: 620px; margin-top: 1.25rem; color: var(--color-muted); font-size: 1.05rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero-watch { display: grid; gap: 0.55rem; min-height: 520px; padding: 2rem; color: inherit; text-decoration: none; background: var(--color-surface); border: 1px solid var(--color-border); }
  .hero-watch span, .product-info span { color: var(--color-accent); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .hero-watch img { width: 100%; height: 320px; object-fit: contain; align-self: center; }
  .hero-watch strong { font-family: var(--font-serif); font-size: 1.15rem; font-weight: 400; line-height: 1.35; }
  .hero-watch em { color: var(--color-accent); font-family: var(--font-serif); font-style: normal; font-size: 1.1rem; }
  .hero-watch small, .product-info small { color: var(--color-muted); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .beliefs { padding: var(--spacing-xl) 0; background: var(--color-surface); }
  .beliefs-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 4rem; align-items: start; }
  .belief-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--color-border); }
  .belief-list article { min-height: 230px; padding: 1.5rem; background: var(--color-surface); }
  .belief-list span { display: block; margin-bottom: 2.5rem; color: var(--color-accent); font-family: var(--font-serif); font-size: 2rem; opacity: 0.45; }
  .belief-list p { margin-top: 0.75rem; color: var(--color-muted); font-size: 0.9rem; }
  .featured { padding: var(--spacing-xl) 0; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: 2rem; }
  .text-link { color: var(--color-accent); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.08em; text-decoration: none; text-transform: uppercase; }
  .product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--color-border); border: 1px solid var(--color-border); }
  .product-card { display: flex; flex-direction: column; min-width: 0; color: inherit; text-decoration: none; background: var(--color-surface); }
  .product-image { display: grid; place-items: center; aspect-ratio: 1; padding: 1rem; background: #f7f3ed; }
  .product-image img { width: 100%; height: 100%; object-fit: contain; }
  .product-info { display: grid; gap: 0.35rem; padding: 1rem; }
  .product-info h3 { display: -webkit-box; min-height: 3.2em; overflow: hidden; font-family: var(--font-sans); font-size: 0.88rem; font-weight: 400; line-height: 1.6; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .product-info strong { color: var(--color-accent); font-family: var(--font-serif); font-size: 1rem; }
  .brand-strip { padding: 4rem 0; background: var(--color-surface); border-block: 1px solid var(--color-border); }
  .brand-list { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .brand-list span { border: 1px solid var(--color-border); padding: 0.55rem 0.85rem; background: var(--color-bg); color: var(--color-subtle); font-size: 0.85rem; }
  @media (max-width: 980px) { .hero-grid, .beliefs-grid { grid-template-columns: 1fr; } .product-grid { grid-template-columns: repeat(2, 1fr); } .belief-list { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .home-hero { padding: 4rem 0; } .hero-watch { padding: 1rem; } .product-grid { grid-template-columns: 1fr; } .section-heading { flex-direction: column; align-items: start; } }
</style>

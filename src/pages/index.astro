---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Uhrgeschichten" description="Entdecken Sie Zeitmesser mit Geschichte. Kuratierte Uhren für Menschen, die Wert auf Handwerk und Qualität legen.">
  <div class="hero">
    <div class="subtitle">Kuratierte Zeitmesser</div>
    <h1>Jede Uhr hat eine Geschichte</h1>
    <p>Für uns ist eine Uhr mehr als ein Instrument. Sie ist ein Begleiter durch die Momente, die zählen. Entdecken Sie unsere kuratierte Kollektion von Zeitmessern – jedes mit einer Geschichte, die es wert ist, erzählt zu werden.</p>
    <a href="/uhren" class="btn" style="margin-top: 2rem;">Uhren entdecken</a>
  </div>
  <div style="text-align: center; padding: var(--spacing-lg) 0;">
    <h2>Ausgewählte Geschichten</h2>
    <p style="color: var(--color-muted);">Bald verfügbar — unsere kuratierte Kollektion.</p>
  </div>
</BaseLayout>
